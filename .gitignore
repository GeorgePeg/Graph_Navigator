#=========================================
# Python & Bytecode Cache
__pycache__/
*.py[cod]
*$py.class
*.so

#=========================================
# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

#=========================================
# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
*.py,cover

#=========================================
# PyInstaller & Excecutable Build Files
build/
test/
*.manifest
*.spec

#=========================================
# Application Data & Outputs
# Ignores the generated Maps/Graphs, keep .gitkeep
data/*
!data/.gitkeep
data/*.graphml
outputs/*
outputs/*.html
!outputs/.gitkeep

#=========================================
# IDEs, Editors & OS Files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.idea/

#=========================================
# Operating System & Database
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
